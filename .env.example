# Copy to .env before running `make up`. The .env file is gitignored.
#
#     cp .env.example .env
#
# These values are local development defaults only. Nothing here is a real
# secret, and nothing here should ever be reused outside a local machine.

# ---- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=sentinelflow
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=sentinelflow
POSTGRES_PORT=5432

# ---- Kafka -------------------------------------------------------------------
# 29092 is the host-facing listener; containers reach the broker on kafka:9092.
KAFKA_HOST_PORT=29092
KAFKA_TOPIC=telemetry.events.v1
KAFKA_PARTITIONS=3
KAFKA_CONSUMER_GROUP=incident-engine-v1

# ---- Service ports (host side) -----------------------------------------------
INGESTION_API_PORT=8080
INCIDENT_ENGINE_PORT=8081
ORDER_SERVICE_PORT=8082
PAYMENT_SERVICE_PORT=8083
INCIDENTS_API_PORT=8084
ALERTING_PORT=8085
REMEDIATION_PORT=8086
DASHBOARD_PORT=3000

# ---- Temporal ----------------------------------------------------------------
# The workflow engine that drives alert escalation. The server reuses PostgreSQL
# for its own schema. The Web UI is optional (start it with the `ui` profile:
# docker compose --profile ui up -d temporal-ui).
TEMPORAL_GRPC_PORT=7233
TEMPORAL_UI_PORT=8233

# ---- OpenTelemetry Collector (optional `otel` profile) -----------------------
# Start with: docker compose --profile otel up -d otel-collector
# Then set the exporters below to `otlp` and point them at http://otel-collector:4318
OTEL_HTTP_PORT=4318
OTEL_GRPC_PORT=4317
OTEL_PROM_PORT=8889

# ---- Application behaviour ---------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=info
TENANT_ID=demo-tenant

# Maximum accepted request body for POST /v1/events.
MAX_BODY_BYTES=65536

# Share of simulated requests that fail, between 0 and 1.
ORDER_FAILURE_RATE=0.1
PAYMENT_FAILURE_RATE=0.2

# Simulated work duration range for the demo services.
MIN_LATENCY=20ms
MAX_LATENCY=250ms

# Bounded retry policy for transient database failures in the incident engine.
DB_RETRY_ATTEMPTS=5
DB_RETRY_BASE_DELAY=100ms
DB_RETRY_MAX_DELAY=5s

# ---- Correlation (incident engine) -------------------------------------------
# The engine evaluates detection rules over the stored event stream on this
# cadence, looking back over CORRELATION_WINDOW. The error-rate rule opens an
# incident when the error/critical fraction for a service meets the threshold,
# given at least MIN_EVENTS samples. An incident with no fresh detection for
# RESOLVE_AFTER auto-resolves. Set CORRELATION_ENABLED=false for a pure ingester.
CORRELATION_ENABLED=true
CORRELATION_INTERVAL=15s
CORRELATION_WINDOW=60s
CORRELATION_ERROR_RATE_THRESHOLD=0.5
CORRELATION_ERROR_RATE_MIN_EVENTS=5
CORRELATION_RESOLVE_AFTER=5m

# ---- Alerting (alert worker) -------------------------------------------------
# How often the poller starts alert workflows for newly-opened incidents, and an
# optional webhook every notification is POSTed to (empty = log-only delivery).
# The escalation policy is embedded; override it with ESCALATION_POLICY_PATH.
ALERT_POLL_INTERVAL=10s
ALERT_WEBHOOK_URL=

# ---- Remediation (remediation worker) ----------------------------------------
# How often the poller starts runbook runs for newly-opened incidents. The
# runbook catalog is embedded; override it with RUNBOOK_CATALOG_PATH. Steps that
# touch anything real are approval-gated by default -- see internal/runbook.
REMEDIATION_POLL_INTERVAL=10s

# ---- OpenTelemetry -----------------------------------------------------------
# stdout | otlp | none
#
# Defaults to none so that `make logs` shows application logs rather than span
# dumps. Set both to stdout to watch traces and metrics on the console, or to
# otlp with OTEL_EXPORTER_OTLP_ENDPOINT set to export to a Collector.
OTEL_TRACES_EXPORTER=none
OTEL_METRICS_EXPORTER=none
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_METRIC_EXPORT_INTERVAL=60s
